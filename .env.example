# Copy to .env and pass with --env-file .env. Real environment variables win over this file.
# Only the providers you use need a key.

# Hugging Face token with access to pyannote/speaker-diarization-community-1 (or run `hf auth login`)
HF_TOKEN=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional base URL overrides (Azure OpenAI, a proxy, Ollama on another machine)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible server, used as --llm compat:<model>
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=
